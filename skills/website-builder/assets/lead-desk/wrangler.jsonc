// Lead Desk settings for Cloudflare. Claude fills in the marked values during setup.
{
  "name": "lead-desk",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "lead-desk", "database_id": "FILL-IN-FROM-desk:db" }
  ],
  // Your website addresses, separated by spaces. Forms on other sites are refused.
  // Can also be changed later on the Lead Desk Settings page.
  "vars": { "site_origins": "" },
  // The summary check runs once a day at 13:00 UTC. Change the hour if you like.
  "triggers": { "crons": ["0 13 * * *"] },
  "observability": { "enabled": true }

  // OPTIONAL, only with your domain on Cloudflare (see lead-desk.md):
  // Own address, for example leads.yourbusiness.com:
  //   "routes": [{ "pattern": "leads.yourbusiness.com", "custom_domain": true }],
  // Email alerts through Cloudflare Email Routing:
  //   "send_email": [{ "name": "MAILER" }]
}
